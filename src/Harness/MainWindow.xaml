<Window
    x:Class="Harness.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Harness.Helpers"
    xmlns:local="using:Harness"
    xmlns:viewModels="using:Harness.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Harness">

    <UserControl x:Name="RootLayout"
                 Background="Transparent">
        <Grid x:Name="ShellLayout">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ShellModeStates">
                    <VisualState x:Name="FullMode" />
                    <VisualState x:Name="MediumMode">
                        <VisualState.Setters>
                            <Setter Target="UrlDisplay.Visibility" Value="Collapsed" />
                            <Setter Target="HeartbeatIndicatorSegment.Visibility" Value="Collapsed" />
                            <Setter Target="RunIndicatorSegment.Visibility" Value="Collapsed" />
                            <Setter Target="TopStatusPill.MinWidth" Value="0" />
                            <Setter Target="TopStatusPill.Margin" Value="8,0" />
                            <Setter Target="TopStatusContent.ColumnSpacing" Value="8" />
                            <Setter Target="ModelStatusSegment.MinWidth" Value="128" />
                            <Setter Target="AccessStatusSegment.Margin" Value="8,0,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NarrowMode">
                        <VisualState.Setters>
                            <Setter Target="GatewayWorkspace.DisplayMode" Value="Overlay" />
                            <Setter Target="UrlDisplay.Visibility" Value="Collapsed" />
                            <Setter Target="LatencyBadge.Visibility" Value="Collapsed" />
                            <Setter Target="TopStatusPill.MinWidth" Value="0" />
                            <Setter Target="TopStatusPill.Margin" Value="8,0" />
                            <Setter Target="TopStatusPill.Padding" Value="{StaticResource CompactTopStatusPillPadding}" />
                            <Setter Target="TopStatusContent.ColumnSpacing" Value="{StaticResource CompactTopStatusPillColumnSpacing}" />
                            <Setter Target="HeartbeatSummarySegment.Visibility" Value="Collapsed" />
                            <Setter Target="HeartbeatIndicatorSegment.Visibility" Value="Collapsed" />
                            <Setter Target="ModelStatusSegment.MinWidth" Value="0" />
                            <Setter Target="AccessStatusSegment.Visibility" Value="Collapsed" />
                            <Setter Target="RunIndicatorSegment.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SmallMode">
                        <VisualState.Setters>
                            <Setter Target="GatewayWorkspace.DisplayMode" Value="Overlay" />
                            <Setter Target="EnvironmentSummaryGroup.(Grid.ColumnSpan)" Value="4" />
                            <Setter Target="EnvironmentSummaryGroup.Margin" Value="0,0,0,8" />
                            <Setter Target="TopStatusPill.(Grid.Row)" Value="1" />
                            <Setter Target="TopStatusPill.(Grid.Column)" Value="0" />
                            <Setter Target="TopStatusPill.(Grid.ColumnSpan)" Value="3" />
                            <Setter Target="TitleBarActions.(Grid.Row)" Value="1" />
                            <Setter Target="UrlDisplay.Visibility" Value="Collapsed" />
                            <Setter Target="LatencyBadge.Visibility" Value="Collapsed" />
                            <Setter Target="TopStatusPill.MinWidth" Value="0" />
                            <Setter Target="TopStatusPill.Margin" Value="0,0,8,0" />
                            <Setter Target="TopStatusPill.Padding" Value="{StaticResource CompactTopStatusPillPadding}" />
                            <Setter Target="TopStatusContent.ColumnSpacing" Value="0" />
                            <Setter Target="HeartbeatSummarySegment.Visibility" Value="Collapsed" />
                            <Setter Target="HeartbeatIndicatorSegment.Visibility" Value="Collapsed" />
                            <Setter Target="ModelStatusSegment.Visibility" Value="Collapsed" />
                            <Setter Target="AccessStatusSegment.Visibility" Value="Collapsed" />
                            <Setter Target="RunIndicatorSegment.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CompactMode">
                        <VisualState.Setters>
                            <Setter Target="CommandBarSurface.Padding" Value="{StaticResource CompactTopBarPadding}" />
                            <Setter Target="EnvironmentSummaryGroup.Visibility" Value="Collapsed" />
                            <Setter Target="LatencyBadge.Visibility" Value="Collapsed" />
                            <Setter Target="LoadingRing.Visibility" Value="Collapsed" />
                            <Setter Target="TopStatusPill.MinWidth" Value="{StaticResource CompactTopStatusPillMinWidth}" />
                            <Setter Target="TopStatusPill.Margin" Value="{StaticResource CompactTopStatusPillMargin}" />
                            <Setter Target="TopStatusPill.Padding" Value="{StaticResource CompactTopStatusPillPadding}" />
                            <Setter Target="TopStatusContent.ColumnSpacing" Value="{StaticResource CompactTopStatusPillColumnSpacing}" />
                            <Setter Target="HeartbeatSummarySegment.Visibility" Value="Collapsed" />
                            <Setter Target="HeartbeatIndicatorSegment.Visibility" Value="Collapsed" />
                            <Setter Target="ModelStatusSegment.MinWidth" Value="{StaticResource CompactTopStatusModelSegmentMinWidth}" />
                            <Setter Target="ModelStatusSegment.Margin" Value="{StaticResource CompactTopStatusModelSegmentMargin}" />
                            <Setter Target="AccessStatusSegment.Visibility" Value="Collapsed" />
                            <Setter Target="RunIndicatorSegment.Visibility" Value="Collapsed" />
                            <Setter Target="GatewayPanelButton.Visibility" Value="Collapsed" />
                            <Setter Target="BrowserContentGrid.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              MinHeight="37"
              Margin="0,-1,0,0"
              Background="Transparent"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <Image x:Name="AppIcon"
                       Width="16"
                       Height="16"
                       Source="Assets/apple-touch-icon.png" />
                <TextBlock x:Name="AppTitleText"
                           Text="Harness"
                           VerticalAlignment="Center"
                           helpers:AppTypography.BaseSize="13"
                           FontWeight="SemiBold" />
            </StackPanel>

            <Grid x:Name="TitleBarDragRegion"
                  Grid.Column="2"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />
        </Grid>

        <Grid x:Name="CommandBarSurface"
              Grid.Row="1"
              Padding="12,8"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="EnvironmentSummaryGroup"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8">
                <ComboBox x:Name="EnvironmentSelector"
                          MinWidth="160"
                          MaxWidth="200"
                          ItemsSource="{x:Bind ViewModel.Environments}"
                          SelectedItem="{x:Bind ViewModel.SelectedEnvironment, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Bind helpers:StringResources.SelectEnvironment}"
                          ToolTipService.ToolTip="{x:Bind helpers:StringResources.SelectEnvironment}" />

                <TextBlock x:Name="UrlDisplay"
                           Margin="8,0,0,0"
                           MaxWidth="240"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextSelectionEnabled="True"
                           Text="{x:Bind ViewModel.CurrentUrl, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border x:Name="TopStatusPill"
                    Grid.Column="1"
                    Margin="16,0,12,0"
                    Padding="{StaticResource TopStatusPillPadding}"
                    MinWidth="{StaticResource TopStatusPillMinWidth}"
                    MaxWidth="{StaticResource TopStatusPillMaxWidth}"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid x:Name="TopStatusContent"
                      ColumnSpacing="{StaticResource TopStatusPillColumnSpacing}"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="HeartbeatSummarySegment"
                          Grid.Column="0"
                          MinWidth="56"
                          VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.HeartbeatSummary, Mode=OneWay}"
                                    Foreground="{x:Bind ViewModel.HeartbeatSummaryBrush, Mode=OneWay}"
                                    Style="{StaticResource TopStatusValueTextBlockStyle}"
                                    CharacterSpacing="{StaticResource TopStatusHeartbeatCharacterSpacing}"
                                    HorizontalAlignment="Center" />
                    </Grid>

                    <Grid x:Name="HeartbeatIndicatorSegment"
                          Grid.Column="1"
                          MinWidth="88"
                          VerticalAlignment="Center">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.HeartbeatIndicators, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal"
                                             Spacing="{StaticResource TopStatusIndicatorSpacing}" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:HeartbeatIndicatorViewModel">
                                    <Ellipse Width="5"
                                             Height="5"
                                             Fill="{x:Bind FillBrush, Mode=OneWay}"
                                             Opacity="{x:Bind FillOpacity, Mode=OneWay}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>

                    <Grid x:Name="ModelStatusSegment"
                          Grid.Column="2"
                          Margin="{StaticResource TopStatusModelSegmentMargin}"
                          ColumnSpacing="8"
                          MinWidth="{StaticResource TopStatusModelSegmentMinWidth}"
                          MinHeight="24"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                    Text="{x:Bind helpers:StringResources.MainModelLabel}"
                                    Style="{StaticResource TopStatusLabelTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Grid.Column="1"
                                    Text="{x:Bind ViewModel.ModelSummaryText, Mode=OneWay}"
                                    Style="{StaticResource TopStatusModelValueTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Grid>

                    <Grid x:Name="AccessStatusSegment"
                          Grid.Column="3"
                          Margin="{StaticResource TopStatusAccessSegmentMargin}"
                          MinWidth="76"
                          VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.AccessSummaryText, Mode=OneWay}"
                                   Foreground="{x:Bind ViewModel.AccessSummaryBrush, Mode=OneWay}"
                                   Style="{StaticResource TopStatusValueTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                    </Grid>

                    <Grid x:Name="WorkStatusSegment"
                          Grid.Column="4"
                          MinWidth="88" MaxWidth="156"
                          ColumnSpacing="4"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                    Text="{x:Bind helpers:StringResources.MainStatusLabel}"
                                    Style="{StaticResource TopStatusLabelTextBlockStyle}"
                                    Foreground="{x:Bind ViewModel.WorkStatusBrush, Mode=OneWay}" />

                        <TextBlock Grid.Column="1"
                                    Text="{x:Bind ViewModel.WorkStatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind GetWorkStatusTooltip(ViewModel.IsOpenClawAvailable, ViewModel.GatewayRunText, ViewModel.WorkStatusText), Mode=OneWay}"
                                    Foreground="{x:Bind ViewModel.WorkStatusBrush, Mode=OneWay}"
                                    Style="{StaticResource TopStatusValueTextBlockStyle}"
                                    CharacterSpacing="{StaticResource TopStatusWorkStateCharacterSpacing}"
                                    HorizontalAlignment="Center" />
                    </Grid>

                    <Grid x:Name="RunIndicatorSegment"
                          Grid.Column="5"
                          MinWidth="64"
                          Margin="-2,0,0,0"
                          VerticalAlignment="Center">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.RunIndicators, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal"
                                             Spacing="{StaticResource TopStatusIndicatorSpacing}" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:HeartbeatIndicatorViewModel">
                                    <Ellipse Width="5"
                                             Height="5"
                                             Fill="{x:Bind FillBrush, Mode=OneWay}"
                                             Opacity="{x:Bind FillOpacity, Mode=OneWay}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LatencyBadge"
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    MinWidth="72"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ToolTipService.ToolTip="{x:Bind ViewModel.LatencyTooltipText, Mode=OneWay}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           helpers:AppTypography.BaseSize="11"
                           FontWeight="SemiBold"
                           Foreground="{x:Bind ViewModel.LatencySummaryBrush, Mode=OneWay}"
                           Text="{x:Bind ViewModel.LatencySummaryText, Mode=OneWay}" />
            </Border>

            <StackPanel x:Name="TitleBarActions"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="4">
                <Button x:Name="GatewayPanelButton"
                        Command="{x:Bind ViewModel.ToggleGatewayPanelCommand}"
                        Visibility="{x:Bind ViewModel.GatewayEntryVisibility, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.PanelTitle}"
                        ToolTipService.ToolTip="{x:Bind helpers:ShellGatewayLocalization.PanelSubtitle}"
                        Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                </Button>

                <Button x:Name="PinButton"
                        Click="OnPinClick"
                        AutomationProperties.Name="{x:Bind helpers:StringResources.SettingsAlwaysOnTop}"
                        ToolTipService.ToolTip="{x:Bind helpers:StringResources.SettingsAlwaysOnTop}"
                        Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE718;" FontSize="14" />
                </Button>

                <Button x:Name="ReloadButton"
                        Command="{x:Bind ViewModel.ReloadCommand}"
                        AutomationProperties.Name="{x:Bind helpers:StringResources.Reload}"
                        ToolTipService.ToolTip="{x:Bind helpers:StringResources.Reload}"
                        Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>

                <Button x:Name="StopButton"
                        Command="{x:Bind ViewModel.StopCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind helpers:StringResources.Stop}"
                        ToolTipService.ToolTip="{x:Bind helpers:StringResources.Stop}"
                        Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>

                <Button x:Name="ThemeButton"
                        Click="OnThemeClick"
                        Style="{StaticResource SubtleButtonStyle}">
                    <Viewbox Width="18" Height="18">
                        <Grid Width="24" Height="24">
                            <Grid.Resources>
                                <Style x:Key="ThemeIconStroke" TargetType="Path">
                                    <Setter Property="Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="StrokeThickness" Value="1.6" />
                                    <Setter Property="StrokeStartLineCap" Value="Round" />
                                    <Setter Property="StrokeEndLineCap" Value="Round" />
                                    <Setter Property="StrokeLineJoin" Value="Round" />
                                </Style>
                            </Grid.Resources>
                            <Canvas x:Name="SystemThemeIcon">
                                <Path Data="M12,4 L20,4 Q22,4 22,6 L22,15 Q22,17 20,17 L12,17 Z"
                                      Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.35" />
                                <Path Data="M4,4 L20,4 Q22,4 22,6 L22,15 Q22,17 20,17 L4,17 Q2,17 2,15 L2,6 Q2,4 4,4 Z M12,4 L12,17 M12,17 L12,21 M8,21 L16,21"
                                      Style="{StaticResource ThemeIconStroke}" />
                            </Canvas>
                            <Canvas x:Name="LightThemeIcon" Visibility="Collapsed">
                                <Path Data="M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 Z M12,2 L12,4 M12,20 L12,22 M2,12 L4,12 M20,12 L22,12 M4.9,4.9 L6.3,6.3 M17.7,17.7 L19.1,19.1 M4.9,19.1 L6.3,17.7 M17.7,6.3 L19.1,4.9"
                                      Style="{StaticResource ThemeIconStroke}" />
                            </Canvas>
                            <Canvas x:Name="DarkThemeIcon" Visibility="Collapsed">
                                <Path Data="M20.9,13 A9,9 0 0 1 11,3.1 A9,9 0 1 0 20.9,13 Z"
                                      Style="{StaticResource ThemeIconStroke}" />
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Button>

                <Button x:Name="SettingsButton"
                        Click="OnSettingsClick"
                        AutomationProperties.Name="{x:Bind helpers:StringResources.Settings}"
                        ToolTipService.ToolTip="{x:Bind helpers:StringResources.Settings}"
                        Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>

            </StackPanel>
        </Grid>

        <InfoBar x:Name="ConnectionInfoBar"
                 Grid.Row="2"
                 IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}"
                 Severity="Error"
                 Title="{x:Bind helpers:StringResources.ConnectionIssue}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsClosable="True"
                 Closed="OnInfoBarClosed">
            <InfoBar.ActionButton>
                <Button Content="{x:Bind helpers:StringResources.Retry}"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Visibility="{x:Bind ViewModel.RetryButtonVisibility, Mode=OneWay}"
                        HorizontalAlignment="Right" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar x:Name="DiagnosticInfoBar"
                 Grid.Row="3"
                 IsOpen="{x:Bind ViewModel.IsDiagnosticVisible, Mode=OneWay}"
                 Severity="Informational"
                 Title="{x:Bind helpers:StringResources.DiagnosticsTitle}"
                 Message="{x:Bind ViewModel.DiagnosticSummary, Mode=OneWay}"
                 IsClosable="True"
                 Closed="OnDiagnosticInfoBarClosed" />

        <Grid x:Name="BrowserContentGrid" Grid.Row="4">
            <SplitView x:Name="GatewayWorkspace"
                       DisplayMode="Inline"
                       OpenPaneLength="304"
                       IsPaneOpen="{x:Bind ViewModel.IsOpenClawPanelOpen, Mode=TwoWay}"
                       PaneBackground="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                <SplitView.Pane>
                    <ScrollViewer x:Name="GatewayPaneViewport"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  SizeChanged="OnGatewayPaneSizeChanged"
                                  Visibility="{x:Bind ViewModel.GatewayPanelVisibility, Mode=OneWay}">
                        <Grid x:Name="GatewayPaneLayout"
                              Height="640"
                              Padding="16"
                              RowSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,0,1,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid x:Name="GatewayPaneHeader" RowSpacing="12" SizeChanged="OnGatewayPaneSizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind helpers:ShellGatewayLocalization.PanelTitle}"
                                                   helpers:AppTypography.BaseSize="20" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.GatewayStatusText, Mode=OneWay}"
                                                   helpers:AppTypography.BaseSize="12"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Command="{x:Bind ViewModel.ToggleGatewayPanelCommand}"
                                            AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.ClosePanel}"
                                            ToolTipService.ToolTip="{x:Bind helpers:ShellGatewayLocalization.ClosePanel}"
                                            Style="{StaticResource SubtleButtonStyle}">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <InfoBar Grid.Row="1"
                                         IsOpen="{x:Bind ViewModel.GatewayHasError, Mode=OneWay}"
                                         Message="{x:Bind ViewModel.GatewayErrorText, Mode=OneWay}"
                                         Severity="Warning"
                                         IsClosable="False">
                                    <InfoBar.ActionButton>
                                        <Button Content="{x:Bind ViewModel.GatewayErrorActionText, Mode=OneWay}"
                                                Visibility="{x:Bind ShowWhen(ViewModel.GatewayHasErrorAction), Mode=OneWay}"
                                                Click="OnGatewayRecoveryClick" />
                                    </InfoBar.ActionButton>
                                </InfoBar>

                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{x:Bind helpers:ShellGatewayLocalization.NewSession}"
                                            Command="{x:Bind ViewModel.NewGatewaySessionCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanCreateGatewaySession, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            helpers:AppTypography.BaseSize="14" Style="{ThemeResource AccentButtonStyle}" />
                                    <Button Grid.Column="1"
                                            Command="{x:Bind ViewModel.RefreshGatewayCommand}"
                                            AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.Refresh}"
                                            ToolTipService.ToolTip="{x:Bind helpers:ShellGatewayLocalization.Refresh}">
                                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                    </Button>
                                </Grid>

                                <TextBox Grid.Row="3"
                                         Text="{x:Bind ViewModel.GatewaySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{x:Bind helpers:ShellGatewayLocalization.SearchSessions}"
                                         AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.SearchSessions}" />

                                <Grid Grid.Row="4">
                                    <TextBlock Text="{x:Bind helpers:ShellGatewayLocalization.Sessions}"
                                               Style="{StaticResource GatewaySectionLabelStyle}" />
                                    <ProgressBar Height="2"
                                                 VerticalAlignment="Bottom"
                                                 Margin="0,20,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{x:Bind ShowGatewayProgress(ViewModel.GatewayBusy, ViewModel.GatewaySessionsLoading), Mode=OneWay}" />
                                </Grid>
                            </Grid>

                            <Grid x:Name="GatewaySessionArea" Grid.Row="1" MinHeight="160">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListView x:Name="GatewaySessionList"
                                          IsEnabled="{x:Bind ViewModel.CanSelectGatewaySession, Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.GatewaySessions}"
                                          SelectedItem="{x:Bind ViewModel.SelectedGatewaySession, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          HorizontalContentAlignment="Stretch"
                                          AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.Sessions}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="0,6" Spacing="4">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           helpers:AppTypography.BaseSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Spacing="8"
                                            Margin="8,12"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ShowGatewayEmptyState(ViewModel.GatewaySessions.Count, ViewModel.GatewayBusy, ViewModel.GatewaySessionsLoading, ViewModel.GatewayHasError, ViewModel.GatewayRosterLoaded), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8F2;" FontSize="28"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind helpers:ShellGatewayLocalization.NoSessions}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind helpers:ShellGatewayLocalization.NoSessionsHint}"
                                               helpers:AppTypography.BaseSize="12"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Row="1"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch"
                                        Content="{x:Bind helpers:ShellGatewayLocalization.LoadMore}"
                                        Command="{x:Bind ViewModel.LoadMoreGatewaySessionsCommand}"
                                        Visibility="{x:Bind ShowWhen(ViewModel.GatewayHasMore), Mode=OneWay}" />
                            </Grid>

                            <ScrollViewer x:Name="GatewayPaneDetails"
                                          Grid.Row="2"
                                          MaxHeight="280"
                                          VerticalScrollBarVisibility="Auto"
                                          SizeChanged="OnGatewayPaneSizeChanged">
                                <StackPanel Spacing="10" Padding="0,12,0,0">
                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                                    <TextBlock Text="{x:Bind helpers:ShellGatewayLocalization.SelectedSession}"
                                               Style="{StaticResource GatewaySectionLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.GatewaySessionTitle, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.GatewaySessionTitle, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.GatewaySessionMetadataText, Mode=OneWay}"
                                               helpers:AppTypography.BaseSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.GatewayRunText, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               helpers:AppTypography.BaseSize="12"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="{x:Bind helpers:ShellGatewayLocalization.StopRun}"
                                            Command="{x:Bind ViewModel.StopGatewayRunCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanStopGatewayRun, Mode=OneWay}"
                                            HorizontalAlignment="Stretch" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.GatewayModels}"
                                              SelectedItem="{x:Bind ViewModel.SelectedGatewayModel, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Header="{x:Bind helpers:ShellGatewayLocalization.Model}"
                                              PlaceholderText="{x:Bind helpers:ShellGatewayLocalization.ChooseModel}"
                                              AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.Model}"
                                              IsEnabled="{x:Bind ViewModel.CanModifyGatewaySession, Mode=OneWay}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{x:Bind ViewModel.GatewayCurrentModelNotice, Mode=OneWay}"
                                               Visibility="{x:Bind ShowWhen(ViewModel.HasGatewayCurrentModelNotice), Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               helpers:AppTypography.BaseSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.GatewayThinkingLevels}"
                                              SelectedItem="{x:Bind ViewModel.SelectedGatewayThinkingLevel, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Header="{x:Bind helpers:ShellGatewayLocalization.ThinkingLevel}"
                                              AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.ThinkingLevel}"
                                              IsEnabled="{x:Bind ViewModel.CanSelectGatewayThinkingLevel, Mode=OneWay}"
                                              HorizontalAlignment="Stretch" />
                                    <Button Content="{x:Bind helpers:ShellGatewayLocalization.ApplyModel}"
                                            Command="{x:Bind ViewModel.ApplyGatewayModelCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanApplyGatewayModel, Mode=OneWay}"
                                            HorizontalAlignment="Stretch" />

                                    <Expander Header="{x:Bind helpers:ShellGatewayLocalization.SessionProperties}"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="10">
                                            <TextBox Text="{x:Bind ViewModel.GatewaySessionLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Header="{x:Bind helpers:ShellGatewayLocalization.SessionLabel}"
                                                     PlaceholderText="{x:Bind helpers:ShellGatewayLocalization.SessionLabelHint}"
                                                     AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.SessionLabel}"
                                                     IsEnabled="{x:Bind ViewModel.CanEditGatewayLabel, Mode=OneWay}"
                                                     MaxLength="1024" />
                                            <Button Content="{x:Bind helpers:ShellGatewayLocalization.SaveLabel}"
                                                    Command="{x:Bind ViewModel.ApplyGatewayLabelCommand}"
                                                    IsEnabled="{x:Bind ViewModel.CanApplyGatewayLabel, Mode=OneWay}"
                                                    HorizontalAlignment="Stretch" />
                                            <TextBox Text="{x:Bind ViewModel.GatewayRunIdText, Mode=OneWay}"
                                                     Header="{x:Bind helpers:ShellGatewayLocalization.RunIdentifier}"
                                                     AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.RunIdentifier}"
                                                     IsReadOnly="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                </SplitView.Pane>
                <Grid>
                    <Grid x:Name="WebViewHost" />
                    <StackPanel MaxWidth="380"
                                Margin="24"
                                Spacing="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ShowWhen(ViewModel.IsPlaceholderEnvironment), Mode=OneWay}">
                        <FontIcon Glyph="&#xE774;" FontSize="40"
                                  Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                        <TextBlock Text="{x:Bind helpers:ShellGatewayLocalization.WelcomeTitle}"
                                   helpers:AppTypography.BaseSize="28" Style="{ThemeResource TitleTextBlockStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind helpers:ShellGatewayLocalization.WelcomeHint}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="{x:Bind helpers:ShellGatewayLocalization.Configure}"
                                Click="OnConfigureGatewayClick"
                                HorizontalAlignment="Center"
                                helpers:AppTypography.BaseSize="14" Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                    <ProgressRing x:Name="LoadingRing"
                                  Width="40"
                                  Height="40"
                                  AutomationProperties.Name="{x:Bind helpers:ShellGatewayLocalization.BrowserLoading}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Visibility="Collapsed" />
                </Grid>
            </SplitView>
        </Grid>

        <Grid x:Name="StatusBarSurface"
              Grid.Row="5"
              Padding="12,6"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="6" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot"
                         Width="8"
                         Height="8"
                         VerticalAlignment="Center"
                         Fill="{x:Bind ViewModel.StatusIndicatorBrush, Mode=OneWay}" />
                <TextBlock x:Name="StatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.LiveSetting="Polite"
                            ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            Style="{StaticResource StatusBarTextBlockStyle}"
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </Grid>

            <TextBlock Grid.Column="2"
                        MaxWidth="160"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatusBarTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.GatewayEntryVisibility, Mode=OneWay}"
                        Text="{x:Bind ViewModel.GatewayVersionText, Mode=OneWay}" />
        </Grid>
        </Grid>
    </UserControl>
</Window>
