<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>Harness</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <ApplicationIcon>Assets\WindowIcon.ico</ApplicationIcon>
    <Version>5.3.3</Version>
    <AssemblyVersion>5.3.3.0</AssemblyVersion>
    <FileVersion>5.3.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harness.Core\Harness.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CopyToPublishDirectory is required as well as CopyToOutputDirectory: without it
      the icons land in the build output but not in `dotnet publish`, and the published
      app logs "Failed to load tray icon: 2" and shows no window or tray icon.
    -->
    <Content Include="Assets\**"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    An unpackaged WinUI 3 app does not carry its generated .pri (compiled XAML plus
    the .resw string tables) into the publish output, so `dotnet publish` produces a
    folder whose first InitializeComponent throws XamlParseException. Add the PRI to
    the publish manifest explicitly.
  -->
  <Target Name="PublishProjectPriFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             Condition="'$(ProjectPriFullPath)' != '' And Exists('$(ProjectPriFullPath)')"
                             RelativePath="$(ProjectPriFileName)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Services\HostedUiBridge.Script.js" LogicalName="Harness.Services.HostedUiBridge.Script.js" />
    <EmbeddedResource Include="Services\HostedUiBridge.HostMessaging.js" LogicalName="Harness.Services.HostedUiBridge.HostMessaging.js" />
    <EmbeddedResource Include="Services\HostedUiBridge.MutationFilter.js" LogicalName="Harness.Services.HostedUiBridge.MutationFilter.js" />
    <EmbeddedResource Include="Services\HostedUiBridge.ModelResolver.js" LogicalName="Harness.Services.HostedUiBridge.ModelResolver.js" />
    <EmbeddedResource Include="Services\HostedUiBridge.DomUtilities.js" LogicalName="Harness.Services.HostedUiBridge.DomUtilities.js" />
    <EmbeddedResource Include="Services\HostedUiBridge.ModelDomFallback.js" LogicalName="Harness.Services.HostedUiBridge.ModelDomFallback.js" />
    <EmbeddedResource Include="Services\HostedUiBridge.ActivityState.js" LogicalName="Harness.Services.HostedUiBridge.ActivityState.js" />
    <EmbeddedResource Include="Services\HostedUiBridge.PhaseClassifier.js" LogicalName="Harness.Services.HostedUiBridge.PhaseClassifier.js" />
    <EmbeddedResource Include="Services\HostedUiBridge.StatusInspection.js" LogicalName="Harness.Services.HostedUiBridge.StatusInspection.js" />
    <EmbeddedResource Include="Services\HostedUiBridge.CommandDispatch.js" LogicalName="Harness.Services.HostedUiBridge.CommandDispatch.js" />
    <EmbeddedResource Include="Services\WebViewCommands.StopInjection.js" LogicalName="Harness.Services.WebViewCommands.StopInjection.js" />
    <EmbeddedResource Include="Services\WebViewCommands.AbortRun.js" LogicalName="Harness.Services.WebViewCommands.AbortRun.js" />
    <EmbeddedResource Include="Services\WebViewStatusInspector.Inspect.js" LogicalName="Harness.Services.WebViewStatusInspector.Inspect.js" />
  </ItemGroup>

</Project>
